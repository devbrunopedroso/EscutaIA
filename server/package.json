    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.23.1",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
