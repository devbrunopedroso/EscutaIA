# Copie para .env e ajuste.

# Obrigatório em produção: string aleatória longa (ex.: openssl rand -hex 32)
JWT_SECRET=

# Claude: o mais simples é cada usuário colar o token em Configurações → Claude, no site.
# Para definir um token padrão para todos, escolha UM:
# a) Produção / multiusuário: chave da API (https://platform.claude.com)
ANTHROPIC_API_KEY=
# b) Só para desenvolvimento / uso pessoal: token da sua assinatura (gerado com `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Modelo do Claude (padrão: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Whisper: tiny | base | small | medium | large-v3-turbo  (maior = melhor e mais lento)
WHISPER_MODEL=small
WHISPER_LANG=pt
WHISPER_THREADS=4

# Identificação de quem fala (on/off). Limite: menor separa mais vozes, maior junta mais.
DIARIZATION=on
DIARIZATION_THRESHOLD=0.5

# Endereço público do site (usado no zip da extensão). Sem ele, usa o endereço da requisição.
# PUBLIC_URL=https://escutaia.suaempresa.com

# Depois de publicar a extensão na Chrome Web Store: o site mostra "Adicionar ao Chrome".
# EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/...

# Senha do Postgres do docker-compose
POSTGRES_PASSWORD=escutaia
